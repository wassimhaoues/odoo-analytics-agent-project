<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_analytics" model="res.groups.privilege">
        <field name="name">CommercePulse Analytics</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_website"/>
    </record>

    <record id="group_analytics_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_analytics"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Reads tracking events, outbox, metrics and alerts.</field>
    </record>

    <record id="group_analytics_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_analytics"/>
        <field name="implied_ids" eval="[(4, ref('group_analytics_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Settings, retries, demo traffic, deletion.</field>
    </record>
</odoo>
