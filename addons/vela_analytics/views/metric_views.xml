<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_metric_list" model="ir.ui.view">
        <field name="name">vela.analytics.metric.list</field>
        <field name="model">vela.analytics.metric</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="window_start"/>
                <field name="metric_key"/>
                <field name="segment"/>
                <field name="value"/>
                <field name="numerator" optional="hide"/>
                <field name="denominator" optional="hide"/>
                <field name="dataset" widget="badge" decoration-warning="dataset == 'demo'"/>
                <field name="source" optional="hide"/>
                <field name="computed_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_metric_graph" model="ir.ui.view">
        <field name="name">vela.analytics.metric.graph</field>
        <field name="model">vela.analytics.metric</field>
        <field name="arch" type="xml">
            <graph type="line">
                <field name="window_start" interval="hour"/>
                <field name="metric_key"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_metric_pivot" model="ir.ui.view">
        <field name="name">vela.analytics.metric.pivot</field>
        <field name="model">vela.analytics.metric</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="metric_key" type="row"/>
                <field name="window_start" interval="hour" type="col"/>
                <field name="value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_metric_search" model="ir.ui.view">
        <field name="name">vela.analytics.metric.search</field>
        <field name="model">vela.analytics.metric</field>
        <field name="arch" type="xml">
            <search>
                <field name="metric_key"/>
                <field name="segment"/>
                <filter string="Real" name="real" domain="[('dataset', '=', 'real')]"/>
                <filter string="Demo" name="demo" domain="[('dataset', '=', 'demo')]"/>
                <separator/>
                <filter string="All traffic" name="seg_all" domain="[('segment', '=', 'all')]"/>
                <filter string="Checkout error ratio" name="ratio"
                        domain="[('metric_key', '=', 'checkout_error_ratio')]"/>
                <filter string="Add to cart by product" name="adds"
                        domain="[('metric_key', '=', 'add_to_cart')]"/>
                <separator/>
                <filter string="Window" name="filter_window" date="window_start"/>
                <group>
                    <filter string="Metric" name="group_key" context="{'group_by': 'metric_key'}"/>
                    <filter string="Segment" name="group_segment" context="{'group_by': 'segment'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_metrics" model="ir.actions.act_window">
        <field name="name">Metrics</field>
        <field name="res_model">vela.analytics.metric</field>
        <field name="view_mode">list,graph,pivot</field>
        <field name="context">{'search_default_real': 1, 'search_default_seg_all': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No metrics yet</p>
            <p>Every 5 minutes Odoo turns events into windowed KPIs. Use
               <b>Generate demo traffic</b> to see them with sample data.</p>
        </field>
    </record>
</odoo>
